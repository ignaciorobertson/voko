# ==========================================
# VOKO — Plantilla de Variables de Entorno
# ==========================================

# Configuración del Backend API (NestJS)
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Base de Datos PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=voko_user
DB_PASSWORD=voko_secure_password
DB_NAME=voko_db
DB_SSL=false

# Autenticación y Criptografía
JWT_ACCESS_SECRET=development_access_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=development_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api/v1
