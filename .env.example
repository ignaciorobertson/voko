# ==========================================
# VOKO — Plantilla de Variables de Entorno
# ==========================================

# Configuración del Backend API (NestJS)
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Base de Datos PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=voko_user
DB_PASSWORD=voko_secure_password
DB_NAME=voko_db
DB_SSL=false

# Autenticación y Criptografía
JWT_ACCESS_SECRET=development_access_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=development_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Resend — Correo electrónico exclusivo para recuperación de contraseñas
# En desarrollo: si se omite RESEND_API_KEY, el sistema usa el proveedor LOCAL seguro mostrando el enlace en logs.
# En producción: ingresar la clave de Resend y un remitente validado en tu dominio.
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM_EMAIL=Voko <onboarding@resend.dev>

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api/v1
